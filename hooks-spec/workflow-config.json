{
  "framework": "SAGE",
  "version": "1.0.0",
  "product": "Profitability",

  "linear": {
    "teamId": "3c37f68c-30a9-4d56-838e-9a79aa569384",
    "featureIssueStates": [
      "Backlog",
      "PRD In Progress",
      "PRD Under Review",
      "Ready",
      "Planned"
    ],
    "phaseIssueStates": {
      "sprint": [
        "Pending Approval",
        "Approved",
        "Foundation Verified",
        "In Progress",
        "Build Complete",
        "Done"
      ],
      "mob": [
        "Pending Approval",
        "Approved",
        "In Progress",
        "Build Complete",
        "Done"
      ],
      "pair": [
        "Pending Approval",
        "Approved",
        "In Progress",
        "Build Complete",
        "Done"
      ],
      "solo": [
        "Pending Approval",
        "Approved",
        "In Progress",
        "Build Complete",
        "Done"
      ]
    },
    "skillUpdateIssueStates": [
      "Pending Approval",
      "Approved",
      "Applied",
      "Rejected\u2014recorded",
      "Apply Failed"
    ],
    "labels": {
      "skillUpdate": "skill-update",
      "violation": "violation"
    },
    "approvers": {
      "prd-completeness-check": "Product Manager",
      "prd-interviewer": "Product Manager",
      "phase-splitter": "Lead Dev"
    }
  },

  "modes": {
    "mob": {
      "description": "Single terminal, sequential, co-located or screenshare",
      "minDevs": 1,
      "maxDevs": 6,
      "worktrees": false,
      "kickoff": {
        "required": true,
        "type": "mob-kickoff",
        "durationMinutes": 120,
        "steps": {
          "prdDiscussion": 45,
          "phaseBreakdown": 45,
          "sessionSetup": 30
        }
      },
      "featureWalkthrough": {
        "required": true,
        "dayBefore": true,
        "durationMinutes": 60
      },
      "prdRequired": true
    },
    "sprint": {
      "description": "Parallel worktrees, distributed team, async-first",
      "minDevs": 2,
      "maxDevs": 3,
      "worktrees": true,
      "worktreeRoot": "C:\\Sage\\worktrees\\",
      "kickoff": {
        "required": true,
        "type": "sprint-kickoff",
        "durationMinutes": 75,
        "steps": {
          "kickoffDevReview": 35,
          "phaseSplitter": 30,
          "manifestGeneration": 10
        }
      },
      "featureWalkthrough": {
        "required": false
      },
      "prdRequired": true
    },
    "pair": {
      "description": "Sequential phases, 2 devs, async kick-off",
      "minDevs": 2,
      "maxDevs": 2,
      "worktrees": false,
      "kickoff": {
        "required": true,
        "type": "async"
      },
      "prdRequired": true
    },
    "solo": {
      "description": "Single developer, hotfix or minor work",
      "minDevs": 1,
      "maxDevs": 1,
      "worktrees": false,
      "kickoff": {
        "required": false
      },
      "prdRequired": false
    }
  },

  "buildMode": {
    "defaultBuildMode": "autonomous",
    "availableModes": ["autonomous", "checkpoint"],
    "checkpointBatchTestCommand": {
      "dotnet": "dotnet test --filter \"Phase{phaseId}Batch{batchId}\" --no-build"
    },
    "batchBoundaryRules": {
      "database": [
        "schema-and-migrations",
        "core-crud-procedures",
        "edge-case-procedures-and-functions"
      ],
      "api": [
        "data-models-and-dal",
        "service-layer",
        "controllers-and-endpoints"
      ],
      "ui": [
        "component-structure-and-data-binding",
        "state-transitions-and-interactions",
        "error-states-and-edge-cases"
      ],
      "full-stack": ["database-layer", "api-layer", "ui-layer"]
    }
  },

  "prd": {
    "completenessThreshold": 80,
    "thresholdAutoCalibrated": true,
    "prdDir": ".sage/prds",
    "requiredInterviewBranch": "develop",
    "remoteName": "origin",
    "telemetryFile": ".sage/prd-interview-telemetry.jsonl"
  },

  "intel": {
    "dir": ".sage/intel",
    "velocityFile": ".sage/intel/velocity-history.jsonl",
    "releaseFile": ".sage/intel/release-history.jsonl",
    "calibrationFiles": {
      "mob": ".sage/intel/mob-calibration.json",
      "sprint": ".sage/intel/sprint-calibration.json",
      "pair": ".sage/intel/pair-calibration.json"
    },
    "notionDashboardUrl": "https://app.notion.com/p/SAGE-Metrics-Dashboard-353b0a7bc8b281ac90f3da541f579292",
    "notionPublishEnabled": true
  },

  "releaseCalendarUrl": "https://app.notion.com/p/SAGE-Release-Calendar-353b0a7bc8b2814e9b54f47e9bf5ecd7",

  "telemetry": {
    "filename": "workflow-telemetry.jsonl",
    "scope": "session",
    "evaluationCycleInterval": 1,
    "skillEvaluationCycleInterval": 5
  },

  "hooks": {
    "scriptDir": ".cursor/hooks/scripts",
    "timeoutMs": {
      "default": 3000,
      "telemetryLogger": 2000,
      "skillUpdateTriggerWatcher": 5000
    }
  },

  "skillUpdates": {
    "stagingDir": ".skill-update-staging",
    "triggerDir": ".skill-update-triggers",
    "historyFile": ".sage/skill-update-history.jsonl",
    "suppressionCycles": 2
  },

  "phases": {
    "stepSequence": [
      "dev-interview",
      "implementation-plan",
      "traceability-review",
      "plan-validation",
      "build",
      "code-review",
      "security-review",
      "agent-testing",
      "completion-report"
    ],
    "artifactNames": {
      "dev-interview":       "phase-{N}-dev-interview-summary.md",
      "implementation-plan": "phase-{N}-implementation-plan.md",
      "traceability-review": "phase-{N}-traceability-review.md",
      "plan-validation":     "phase-{N}-plan-preview.canvas.tsx",
      "build":               "(source files)",
      "code-review":         "phase-{N}-code-review.md",
      "security-review":     "phase-{N}-security-review.md",
      "agent-testing":       "phase-{N}-test-results.md",
      "completion-report":   "phase-{N}-completion-report.md"
    }
  },

  "skillUpdate": {
    "pollIntervalSeconds": 60,
    "triggerDir": ".skill-update-triggers",
    "pollCursorFile": ".sage/skill-update-poll-cursor.txt"
  },

  "featureFlags": {
    "humanQAGate": false,
    "playwrightE2E": true
  }
}
